# Tesseract reads print locally. Set a Gemini key to enable the separate handwriting option.
OCR_PROVIDER=tesseract
TESSERACT_LANGUAGES=eng+heb
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Absolute path to a service-account JSON kept outside the project.
SHEETS_CREDENTIALS_FILE=
SHEETS_SPREADSHEET_ID=
SHEETS_TAB=Scans
